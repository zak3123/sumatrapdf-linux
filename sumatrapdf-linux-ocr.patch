+static TempStr FindOcrDataDirTemp() {
+    const char* env = getenv("TESSDATA_PREFIX");
+    TempStr result;
+    if (env) {
+        result = OcrDataDirIfValidTemp(Str(env));
+        if (result) {
+            return result;
+        }
+        result = OcrDataDirIfValidTemp(path::JoinTemp(Str(env), StrL("tessdata")));
+        if (result) {
+            return result;
+        }
+    }
+
+    result = OcrDataDirIfValidTemp(path::JoinTemp(GetSelfExeDirTemp(), StrL("tessdata")));
+    if (result) {
+        return result;
+    }
+    const char* home = getenv("HOME");
+    if (home) {
+        result = OcrDataDirIfValidTemp(path::JoinTemp(Str(home), StrL(".local/share/sumatrapdf/tessdata")));
+        if (result) {
+            return result;
+        }
+    }
+
+    const char* systemDirs[] = {
+        "/usr/share/tesseract/tessdata",
+        "/usr/share/tesseract-ocr/5/tessdata",
+        "/usr/share/tesseract-ocr/4.00/tessdata",
+        "/usr/share/tessdata",
+        "/usr/local/share/tessdata",
+        "/app/share/tessdata",
+    };
+    for (const char* dir : systemDirs) {
+        result = OcrDataDirIfValidTemp(Str(dir));
+        if (result) {
+            return result;
+        }
+    }
+    return {};
+}
+
+static TempStr GetOcrTextTemp(WindowTab* tab, TempStr* errorOut) {
+    DisplayModel* dm = tab ? tab->AsFixed() : nullptr;
+    if (!dm || !tab->selectionOnPage || len(*tab->selectionOnPage) == 0) {
+        return {};
+    }
+    TempStr dataDir = FindOcrDataDirTemp();
+    if (len(dataDir) == 0) {
+        *errorOut = str::DupTemp(StrL("OCR data eng.traineddata was not found"));
+        return {};
+    }
+    Pixmap* pixmap = RenderSelectionsAsPixmap(dm, *tab->selectionOnPage);
+    if (!pixmap) {
+        *errorOut = str::DupTemp(StrL("Could not render the selected area for OCR"));
+        return {};
+    }
+
+    TempStr result;
+    fz_context* ctx = fz_new_context(nullptr, nullptr, FZ_STORE_DEFAULT);
+    if (!ctx) {
+        FreePixmap(pixmap);
+        *errorOut = str::DupTemp(StrL("Could not initialize OCR"));
+        return {};
+    }
+    fz_buffer* text = nullptr;
+    fz_var(text);
+    fz_try(ctx) {
+        text = sumatra_ocr_bgra_text(ctx, pixmap->data, pixmap->width, pixmap->height, pixmap->stride,
+                                     (int)pixmap->xres, (int)pixmap->yres, "eng", CStrTemp(dataDir));
+        unsigned char* data = nullptr;
+        size_t size = fz_buffer_storage(ctx, text, &data);
+        Str recognized((const char*)data, (int)size);
+        str::TrimWsBoth(recognized);
+        result = str::DupTemp(recognized);
+    }
+    fz_always(ctx) {
+        fz_drop_buffer(ctx, text);
+    }
+    fz_catch(ctx) {
+        *errorOut = str::DupTemp(Str(fz_caught_message(ctx)));
+    }
+    fz_drop_context(ctx);
+    FreePixmap(pixmap);
+    return result;
+}
