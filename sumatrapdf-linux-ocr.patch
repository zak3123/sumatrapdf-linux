+static bool NeedsOcrText(const PageText& pageText) {
+    if (str::IsEmptyOrWhiteSpace(pageText.text)) {
+        return true;
+    }
+
+    Str text(pageText.text);
+    int nCodepoints = Utf8CodepointCount(text);
+    if (!pageText.coords || nCodepoints < 8) {
+        return false;
+    }
+
+    int byteIdx = 0;
+    int visible = 0;
+    int selectable = 0;
+    for (int i = 0; i < nCodepoints; i++) {
+        int cp = Utf8CodepointNext(text, byteIdx);
+        if (cp <= 0x7f && str::IsWs((char)cp)) {
+            continue;
+        }
+        visible++;
+        const Rect& box = pageText.coords[i];
+        if (box.dx > 0 && box.dy > 0) {
+            selectable++;
+        }
+    }
+
+    // Some scanned PDFs contain a malformed hidden text layer whose Unicode is
+    // readable but whose glyph boxes have zero width. It cannot be hit-tested,
+    // so replace it with OCR geometry when most visible characters are broken.
+    return visible >= 8 && selectable * 2 < visible;
+}
+
+static bool HasJapaneseKana(Str text) {
+    int byteIdx = 0;
+    while (byteIdx < len(text)) {
+        int cp = Utf8CodepointNext(text, byteIdx);
+        if ((cp >= 0x3040 && cp <= 0x30ff) || (cp >= 0x31f0 && cp <= 0x31ff)) {
+            return true;
+        }
+    }
+    return false;
+}
